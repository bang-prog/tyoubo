# Cloudflare Pages の HTTP ヘッダー
# 入れ替わるファイル(サービスワーカー・マニフェスト・画面の入口)は毎回確認させ、新しい版がすぐ届くようにする
/sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# 名前に中身のハッシュが入っているファイルは変わらないので、長く保存させる
/assets/*
  Cache-Control: public, max-age=31536000, immutable
